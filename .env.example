# Copy to .env and adjust. Compose supplies its own values for the datastore
# hosts, so for a plain `docker compose up` the only line that matters is the
# Anthropic key.

# --- Enrichment -------------------------------------------------------------
# Optional. Without it the pipeline runs with RuleBasedEnricher: regex tickers
# and keyword topics instead of LLM extraction. Everything else behaves the same.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Datastores (compose overrides these; defaults suit running on the host) --
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=newswire
POSTGRES_PASSWORD=newswire
POSTGRES_DB=newswire

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=newswire
RABBITMQ_PASSWORD=newswire

# --- Tuning -----------------------------------------------------------------
PREFETCH_COUNT=8
MAX_RETRIES=3
POLL_INTERVAL_SECONDS=600
SIMHASH_DISTANCE_THRESHOLD=3
